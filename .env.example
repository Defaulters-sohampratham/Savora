# ==============================================================================
# Savora Environment Configuration (Optional)
# ==============================================================================
# NOTE: The dashboard is fully functional OUT OF THE BOX without any keys.
# It uses pre-loaded worker profiles (Ravi, Meena, Farhan) and an offline
# Dvara-calibrated resilience engine fallback.
# ==============================================================================

# [Optional] LLM Explanation Engine (Google Gemini or OpenAI)
# If set, Savora generates live, adaptive explanations for saving recommendations.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Or use OpenAI:
# OPENAI_API_KEY=

# [Optional] Supabase Database & Auth
# Only required if you want live cloud database syncing rather than local demo state.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
